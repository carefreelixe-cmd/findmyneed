PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=services_marketplace

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (AWS SES or SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourmarketplace.com

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Optional production infrastructure. The API continues with PostgreSQL fallbacks
# when Redis or Elasticsearch is not configured.
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=10
OUTBOX_POLL_INTERVAL_MS=2000
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_SERVICES_INDEX=marketplace-services

# API protection
RATE_LIMIT_MAX=300
JSON_BODY_LIMIT=1mb

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
